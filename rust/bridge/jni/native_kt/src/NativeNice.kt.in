{% set ctx = testing_ctx if testing else non_testing_ctx %}

{# Due to how our gradle build is currently configured, many internal items must be public. #}
{% set pub_for_tests = "public" %}

{% macro converter_name(name, kind) %}{{ name|replace(".", "_") }}_{{kind}}{% endmacro %}

{% macro struct_return_converter(name, return_converter) %}
    {{pub_for_tests}} object {{ converter_name(name, "ReturnConverter") }} {
        @CalledFromNative
        @JvmStatic
        @JvmName("fromNative")
        internal fun fromNative(
            {%- for (field, ty) in return_converter.fields -%}{{ field }}: Any?,{%- endfor -%}
        ): {{ name }} = {{ name }}{% if return_converter.fields|count > 0 %}(
            {%- for (field, ty) in return_converter.fields -%}
                {{ field|to_lower_camel_case }} =
                    {{ ty.converter_function }}({{ field }} as {{ ty.ffi_type }}),
            {%- endfor -%}
        ){% endif %}
    }
{% endmacro %}

{% macro struct_arg_converter(name, arg_converter, superclass) %}
    {%- if arg_converter.fields|count == 0 -%}
        @CalledFromNative
        {{pub_for_tests}} object {{ converter_name(name, "FfiArgType") }}
            {%- if superclass -%}: {{ superclass }}(){%- endif -%}
        {{pub_for_tests}} fun {{ name }}.toFfiArgType(): {{ converter_name(name, "FfiArgType") }} =
            {{ converter_name(name, "FfiArgType") }}
    {%- else -%}
        @CalledFromNative
        @Suppress("ktlint:standard:backing-property-naming")
        {{pub_for_tests}} class {{ converter_name(name, "FfiArgType") }}{% if superclass %}: {{ superclass }}{% endif %} {
            {% for (field, ty) in arg_converter.fields %}
                @CalledFromNative
                internal val {{ field }}: {{ ty.ffi_field_type_erased }}
            {%- endfor %}
            internal constructor(
                {% for (field, ty) in arg_converter.fields -%}
                    {{ field }}: {{ ty.ffi_field_type_erased }},
                {%- endfor %}
            ) {
                {%- for (field, ty) in arg_converter.fields %}
                    this.{{ field }} = {{ field }}
                {%- endfor %}
            }
        }
        {{pub_for_tests}} fun {{ name }}.toFfiArgType(): {{ converter_name(name, "FfiArgType") }} =
            {{ converter_name(name, "FfiArgType") }}(
                {% for (field, ty) in arg_converter.fields -%}
                    {{ field }} = {{ ty.converter_function }}({{ field|to_lower_camel_case }}),
                {%- endfor %}
            )
    {%- endif -%}
{% endmacro %}

{% macro struct_class(name, struct, superclass) %}
    {%- if struct.fields|count == 0 -%}
        {{pub_for_tests}} data object {{ name }}{% if superclass %}: {{ superclass }}(){% endif %}
    {%- else -%}
        {{pub_for_tests}} data class {{ name }}(
            {% for (field, ty) in struct.fields -%}
                {{pub_for_tests}} val {{ field|to_lower_camel_case }}: {{ ty }},
            {%- endfor %}
        ){% if superclass %}: {{ superclass }}(){% endif %}
    {%- endif -%}
{% endmacro %}

{% for (name, struct_or_enum) in ctx.derived_types|items %}
    {% if struct_or_enum.kind == "Struct" %}
        {{ struct_class(
            name,
            struct_or_enum,
            superclass=none,
        ) }}
    {% else %}
        {{pub_for_tests}} sealed class {{ name }} {
            {% for (variant, struct) in struct_or_enum.variants -%}
                {{ struct_class(
                    variant,
                    struct,
                    superclass=name,
                ) }}
            {%- endfor %}
        }
    {% endif %}
{% endfor %}

{% for (name, struct_or_enum) in ctx.derived_return_converters|items %}
    {% if struct_or_enum.kind == "Struct" %}
        {{ struct_return_converter(
            name,
            struct_or_enum,
        ) }}
    {% else %}
        {% for (variant, struct) in struct_or_enum.variants %}
            {{ struct_return_converter(
                name ~ "." ~ variant,
                struct,
            ) }}
        {% endfor %}
    {% endif %}
{% endfor %}

{% for (name, struct_or_enum) in ctx.derived_arg_converters|items %}
    {% if struct_or_enum.kind == "Struct" %}
        {{ struct_arg_converter(
            name,
            struct_or_enum,
            superclass=none,
        ) }}
        {{pub_for_tests}} fun {{ name }}.toFfiArgTypeObject(): Object =
            convertToObject(this.toFfiArgType())
    {% else %}
        {{pub_for_tests}} sealed class {{ converter_name(name, "FfiArgType") }}()
        {% for (variant, struct) in struct_or_enum.variants %}
            {{ struct_arg_converter(
                name ~ "." ~ variant,
                struct,
                superclass=converter_name(name, "FfiArgType"),
            ) }}
        {% endfor %}
        {{pub_for_tests}} fun {{name}}.toFfiArgTypeObject(): Object = convertToObject(when(this) {
            {% for (variant, struct) in struct_or_enum.variants -%}
                is {{ name }}.{{ variant }} -> this.toFfiArgType()
            {% endfor %}
        })
    {% endif %}
{% endfor %}

{{pub_for_tests}} object {{ "NativeTestingNice" if testing else "NativeNice" }} {
    {% for (name, f) in ctx.nice_functions|items %}
        {{pub_for_tests}} fun {{ name }}(
            {% if f.is_tokio_async -%}
                asyncCtx: TokioAsyncContext,
            {% endif -%}
            {% for (arg, ty) in f.arguments -%}
                {{ arg|to_lower_camel_case }}: {{ ty.nice_type }},
            {% endfor -%}
        ): {% if f.is_tokio_async -%}
            CompletableFuture<{{ f.return_type.nice_type }}>
        {%- else -%}
            {{ f.return_type.nice_type }}
        {%- endif %} {
            {% for (arg, ty) in f.arguments -%}
                val ffi_{{ arg }} = {{ ty.converter_function }}({{ arg|to_lower_camel_case }})
            {% endfor -%}
            val ffiOut = {% if f.is_tokio_async %} NativeHandleGuard(asyncCtx).use { asyncCtxHandle -> {% endif %}
                Native{% if testing %}Testing{% endif %}.{{ name }}(
                    {%- if f.is_tokio_async -%}
                        asyncCtxHandle.nativeHandle(),
                    {%- endif %}
                    {% for (arg, ty) in f.arguments -%}
                        ffi_{{ arg }},
                    {% endfor -%}
                )
            {% if f.is_tokio_async %} } {% endif %}
            {% if f.is_tokio_async -%}
                return ffiOut
                  .makeCancelable(asyncCtx)
                  {% if f.return_type.converter_function != "identity" -%}
                  .thenApply { {{ f.return_type.converter_function }}(it) }
                  {%- endif %}
            {%- else -%}
                return {{ f.return_type.converter_function }}(ffiOut)
            {%- endif %}
        }
    {% endfor %}
}
